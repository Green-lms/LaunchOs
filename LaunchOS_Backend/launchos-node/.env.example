# ═══════════════════════════════════════════════════════════
# LaunchOS™ Backend — environment settings
# Copy this file to ".env" and fill in the values.
# NEVER commit .env or share it in chat — it holds secrets.
# Run "npm run check-env" to see what is still missing.
# ═══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of sites allowed to call the API
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# ── Database (REQUIRED) ─────────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copy the "mongodb+srv://..." string.
# Put the database name "launchos" before the "?" e.g.
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/launchos?retryWrites=true&w=majority
MONGO_URI=

# ── Auth (REQUIRED) ─────────────────────────────────────────
# Long random strings (64+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
# Separate secret needed to self-register a trainer/admin account
ADMIN_INVITE_KEY=

# ── First admin account (used by "npm run setup") ───────────
ADMIN_NAME=Sushma
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── AI (optional until AI proxy is used) ────────────────────
CLAUDE_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=claude

# ── Email (optional — without it emails are only logged) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=LaunchOS™ <hello@theresetlabs.global>

# ── Moodle LMS (optional) ───────────────────────────────────
MOODLE_URL=
MOODLE_TOKEN=

# ── Uploads ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
